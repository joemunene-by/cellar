{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "cellar default capabilities. The user-facing wine / library / runtime / installer commands are wired through invoke_handler in main.rs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "shell:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm"
  ]
}
