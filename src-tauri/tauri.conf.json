{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "cellar",
  "version": "0.1.0",
  "identifier": "com.joemunene.cellar",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "cellar",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "Mac M4 launcher for Windows games",
    "longDescription": "cellar is a Mac mini M4 launcher for Windows games. Wraps Wine + Apple Game Porting Toolkit + DXVK to run repack installers natively on Apple Silicon.",
    "resources": {
      "../scripts": "scripts"
    }
  }
}